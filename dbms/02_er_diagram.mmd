        TIMESTAMP updated_at
    }

    APPLICATIONS {
        SERIAL id PK
        INTEGER project_id FK
        INTEGER applicant_id FK
        VARCHAR_150 desired_role
        TEXT application_message
        VARCHAR status
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    PROJECT_MEMBERS {
        SERIAL id PK
        INTEGER project_id FK
        INTEGER user_id FK
        VARCHAR_150 role_name
        TIMESTAMP joined_at
    }

    NOTIFICATIONS {
        SERIAL id PK
        INTEGER user_id FK
        INTEGER actor_id FK "Nullable"
